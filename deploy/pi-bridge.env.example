# /etc/pi-bridge/pi-bridge.env  — chmod 600, chown root:pi-bridge
PORT=18810
HOST=127.0.0.1
STATE_DIR=/var/lib/pi-bridge

# The public origin. Must be https: OAuth clients will not follow a plaintext
# redirect, and the callback URL below has to match the identity provider.
PUBLIC_URL=https://pi.example.com

# Identity provider (Feishu). Create an app, then add
#   https://pi.example.com/callback
# to its redirect URL whitelist.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only this account may authorize. Find it in the Feishu console; empty means
# "anyone who can reach the app", which is not what you want.
ALLOWED_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# What a pi session presents when it connects. Generate with:
#   head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
AGENT_TOKEN=

# Seconds a held poll waits before returning empty. Keep well under nginx's
# proxy_read_timeout. 0 degrades to plain short polling.
POLL_HOLD_SEC=25
# An agent whose last poll is older than this is considered gone.
AGENT_TTL_SEC=40
# How long an MCP call blocks before handing back a task id instead.
DEFAULT_WAIT_SEC=45
MAX_WAIT_SEC=240
# How long finished tasks stay fetchable with pi_task.
TASK_TTL_SEC=3600

# Set to 1 to allow pi_status and pi_ask only.
# READ_ONLY=0
# Local experiments only — see the security section before using this.
# MCP_ALLOW_NO_AUTH=1
